# oh-my-zsh
export ZSH="$HOME/.oh-my-zsh"
ZSH_THEME="robbyrussell"
plugins=(git zsh-autosuggestions fast-syntax-highlighting)
source $ZSH/oh-my-zsh.sh

# ── PATH ─────────────────────────────────────────────────────────────────────
export PATH="$HOME/.local/bin:$PATH"

# JS package manager (pnpm)
export PNPM_HOME="$HOME/.local/share/pnpm"
case ":$PATH:" in
  *":$PNPM_HOME:"*) ;;
  *) export PATH="$PNPM_HOME:$PATH" ;;
esac

# bun
export BUN_INSTALL="$HOME/.bun"
[ -d "$BUN_INSTALL/bin" ] && export PATH="$BUN_INSTALL/bin:$PATH"
[ -s "$HOME/.bun/_bun" ] && source "$HOME/.bun/_bun"

# user-local docker (rootless) if present
[ -d "$HOME/.docker/bin" ] && export PATH="$HOME/.docker/bin:$PATH"

# ── Editor ───────────────────────────────────────────────────────────────────
# This box is itself the remote machine reached over SSH, so prefer nvim here
# (unlike the macOS config, which drops to vi inside SSH sessions).
if command -v nvim >/dev/null 2>&1; then
  export EDITOR='nvim'
else
  export EDITOR='vim'
fi

# ── Aliases ──────────────────────────────────────────────────────────────────
command -v nvim  >/dev/null 2>&1 && alias vim='nvim'
command -v btop  >/dev/null 2>&1 && alias top='btop'
command -v lsd   >/dev/null 2>&1 && alias ll='lsd -lah --group-dirs first'
command -v dua   >/dev/null 2>&1 && alias du='dua i'
command -v doggo >/dev/null 2>&1 && alias dig='doggo'
command -v glow  >/dev/null 2>&1 && alias glow='glow -w 120'
command -v lazygit >/dev/null 2>&1 && alias lg='lazygit'
command -v yazi  >/dev/null 2>&1 && alias y='yazi'
# pnpm comes from corepack (enabled by fnm init lower down), so define these
# unconditionally — pnpm isn't on PATH yet at this point in the file.
alias pn='pnpm'
alias pnx='pnpx'

alias mkdir='mkdir -pv'
alias gs='git status'
alias myip="curl -s http://ip-api.com/line; echo"
alias cpsafe='rsync -av --progress --exclude node_modules --exclude .git'
alias docker_rmi_dangling='docker rmi $(docker images -q -f dangling=true)'
alias c='claude'
alias cc='cd ~/.claude-chat && claude'

# pass — password store
alias passwords='pass show all | less; clear && tmux clear-history'
alias passwords_edit='EDITOR="vim --clean" pass edit all; clear && tmux clear-history'

# ── Functions ────────────────────────────────────────────────────────────────
# jqless < data.json   |   cat data.json | jqless
jqless() {
    jq -C "$@" | less -R
}

# cheatsh curl   → cheatsheet from cheat.sh
cheatsh() {
  args="${*:?How to use: cheatsh bash copy with progress bar}"
  query=${args// /+}
  query=${query/+//}
  curl cheat.sh/$query
}

# domain_lookup google.com → IP + ASN/owner
domain_lookup() {
  local domain="$1"
  if [ -z "$domain" ]; then
    echo "Usage: domain_lookup <domain>"; return 1
  fi
  local ip_address=$(dig @1.1.1.1 +short "$domain" A | grep -E '^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$' | head -n1)
  if [ -z "$ip_address" ]; then
    echo "$domain: Could not resolve"; return
  fi
  local asn_info=$(whois -h whois.cymru.com " -v $ip_address" 2>/dev/null | tail -n1)
  if [ -n "$asn_info" ]; then
    local asn=$(echo "$asn_info" | awk '{print $1}')
    local country=$(echo "$asn_info" | cut -d'|' -f4 | xargs)
    local owner=$(echo "$asn_info" | cut -d'|' -f5- | xargs)
    if [ -n "$asn" ] && [ "$asn" != "NA" ]; then
      echo "$domain: $ip_address | AS$asn | $country | $owner"
    else
      echo "$domain: $ip_address"
    fi
  else
    echo "$domain: $ip_address"
  fi
}

# ── fzf (fuzzy finder) ───────────────────────────────────────────────────────
if command -v fzf >/dev/null 2>&1; then
  command -v fd >/dev/null 2>&1 && \
    export FZF_DEFAULT_COMMAND='fd --type file --follow --hidden --exclude .git --exclude node_modules'
  alias fzfp="fzf --preview 'bat --color=always --style=numbers --line-range=:500 {}' | xargs -I {} \$EDITOR {}"
  alias fzf="fzf --bind 'enter:execute(\$EDITOR {})'"
fi

# ── Version managers (each guarded — initialized only when installed) ─────────
command -v rbenv >/dev/null 2>&1 && eval "$(rbenv init - zsh)"

export PYENV_ROOT="$HOME/.pyenv"
if [ -d "$PYENV_ROOT/bin" ]; then
  export PATH="$PYENV_ROOT/bin:$PATH"
  eval "$(pyenv init -)"
  command -v pyenv-virtualenv-init >/dev/null 2>&1 && eval "$(pyenv virtualenv-init -)"
fi

command -v fnm >/dev/null 2>&1 && \
  eval "$(fnm env --use-on-cd --corepack-enabled --version-file-strategy recursive --shell zsh)"
